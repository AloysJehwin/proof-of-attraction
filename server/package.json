{
  "name": "proof-of-attraction-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "reset": "node scripts/reset-user.mjs",
    "reset:all": "node scripts/reset-user.mjs --all --bump-action",
    "reset:action": "node scripts/reset-user.mjs --bump-action"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@hono/node-server": "^1.13.7",
    "@neondatabase/serverless": "^1.1.0",
    "@upstash/redis": "^1.38.4",
    "@vercel/blob": "^2.8.0",
    "@worldcoin/agentkit": "^0.2.1",
    "@worldcoin/idkit-core": "^4.2.4",
    "ably": "^2.28.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.14",
    "openai": "^7.15.0",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
